root = true

# Defaults for every file. Two-space indent + LF matches the Prettier-less
# style the rest of the codebase already uses, so diffs stay small.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_size = 2
